From c2165a97c1f5cfc026f0d1f33fd95c101e708f5b Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Wed, 25 Feb 2026 20:31:28 +0000
Subject: [PATCH 3/3] wip am62l 2D demo: add flip button support and FPS HUD

Signed-off-by: tloan <tloan@phytec.com>
---
 CMakeLists.txt |  2 +-
 main.c         | 98 ++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 99 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9cc517f..fd2fc33 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,7 +10,7 @@ set(EXECUTABLE_OUTPUT_PATH ${PROJECT_SOURCE_DIR}/bin)
 add_subdirectory(lvgl)
 target_include_directories(lvgl PUBLIC ${PROJECT_SOURCE_DIR} ${PROJECT_SOURCE_DIR}/lvgl/src/drivers/wayland)
 
-add_executable(main main.c mouse_cursor_icon.c lvgl/src/drivers/wayland/lv_wayland.c lvgl/src/drivers/wayland/lv_wayland_smm.c lvgl/src/drivers/wayland/wayland_xdg_shell.c AM62L_Back.c AM62L_Front.c)
+add_executable(main main.c mouse_cursor_icon.c lvgl/src/drivers/wayland/lv_wayland.c lvgl/src/drivers/wayland/lv_wayland_smm.c lvgl/src/drivers/wayland/wayland_xdg_shell.c AM62L_Back.c AM62L_Front.c flip_icon.c)
 
 target_link_libraries(main lvgl lvgl::examples lvgl::demos lvgl::thorvg ${SDL2_LIBRARIES} wayland-client wayland-cursor xkbcommon m pthread)
 add_custom_target (run COMMAND ${EXECUTABLE_OUTPUT_PATH}/main DEPENDS main)
diff --git a/main.c b/main.c
index e3572b3..e2854aa 100644
--- a/main.c
+++ b/main.c
@@ -3,9 +3,77 @@
 #include "lvgl/src/drivers/wayland/lv_wayland.h"
 
 #include <unistd.h>
+#include <stdio.h>
 
 LV_IMAGE_DECLARE(AM62L_Front);
 LV_IMAGE_DECLARE(AM62L_Back);
+LV_IMAGE_DECLARE(flip_icon);
+
+/* -------------------------------------------------------------------------- */
+/* FPS HUD Data & Logic                                                       */
+/* -------------------------------------------------------------------------- */
+const unsigned char font8x8[14][8] = {
+    {0x3E,0x61,0x61,0x61,0x61,0x61,0x3E,0x00}, // 0
+    {0x18,0x08,0x08,0x08,0x08,0x08,0x08,0x00}, // 1
+    {0x3E,0x01,0x01,0x3E,0x60,0x60,0x3E,0x00}, // 2
+    {0x3E,0x01,0x01,0x3E,0x01,0x01,0x3E,0x00}, // 3
+    {0x61,0x61,0x61,0x3F,0x01,0x01,0x01,0x00}, // 4
+    {0x3F,0x60,0x60,0x3E,0x01,0x01,0x3E,0x00}, // 5
+    {0x3E,0x60,0x60,0x3E,0x61,0x61,0x3E,0x00}, // 6
+    {0x3F,0x01,0x01,0x02,0x04,0x08,0x08,0x00}, // 7
+    {0x3E,0x61,0x61,0x3E,0x61,0x61,0x3E,0x00}, // 8
+    {0x3E,0x61,0x61,0x3F,0x01,0x01,0x3E,0x00}, // 9
+    {0x7F,0x40,0x40,0x7E,0x40,0x40,0x40,0x00}, // F (10)
+    {0x7E,0x41,0x41,0x7E,0x40,0x40,0x40,0x00}, // P (11)
+    {0x3E,0x40,0x40,0x3E,0x01,0x01,0x3E,0x00}, // S (12)
+    {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}  // Space (13)
+};
+
+#define FPS_HUD_CHARS 7
+static uint32_t fps_buf[FPS_HUD_CHARS * 8 * 8];
+
+static lv_image_dsc_t fps_img_dsc = {
+    .header.magic = LV_IMAGE_HEADER_MAGIC,
+    .header.cf = LV_COLOR_FORMAT_ARGB8888,
+    .header.flags = 0,
+    .header.w = FPS_HUD_CHARS * 8,
+    .header.h = 8,
+    .header.stride = FPS_HUD_CHARS * 8 * 4,
+    .data_size = sizeof(fps_buf),
+    .data = (const uint8_t *)fps_buf,
+};
+static lv_obj_t * fps_img_obj;
+static uint32_t frame_cnt = 0;
+
+static int get_font_idx(char c) {
+    if(c >= '0' && c <= '9') return c - '0';
+    if(c == 'F') return 10;
+    if(c == 'P') return 11;
+    if(c == 'S') return 12;
+    return 13;
+}
+
+static void update_fps_hud(uint32_t fps) {
+    char str[16];
+    snprintf(str, sizeof(str), "FPS %-3lu", fps);
+    uint32_t fg = 0xFF000000; /* Solid Black */
+    uint32_t bg = 0x00000000; /* 100% Transparent */
+
+    for(int i = 0; i < FPS_HUD_CHARS; i++) {
+        int char_idx = get_font_idx(str[i]);
+        for(int y = 0; y < 8; y++) {
+            uint8_t row = font8x8[char_idx][y];
+            for(int x = 0; x < 8; x++) {
+                int px = (i * 8) + x;
+                fps_buf[y * (FPS_HUD_CHARS * 8) + px] = (row & (1 << (7 - x))) ? fg : bg;
+            }
+        }
+    }
+    if(fps_img_obj) lv_obj_invalidate(fps_img_obj);
+}
+
+static void refr_event_cb(lv_event_t * e) { frame_cnt++; }
+static void fps_timer_cb(lv_timer_t * t) { update_fps_hud(frame_cnt); frame_cnt = 0; }
 
 /* -------------------------------------------------------------------------- */
 /* Helper: Calculate dist between two touch points for pinch-zoom feature     */
@@ -124,6 +192,18 @@ static void img_event_cb(lv_event_t * e)
     }
 }
 
+/* -------------------------------------------------------------------------- */
+/* Flip Button Handler                                                        */
+/* -------------------------------------------------------------------------- */
+static void flip_btn_event_cb(lv_event_t * e)
+{
+    lv_obj_t * main_img = lv_event_get_user_data(e);
+    static bool is_front = true;
+
+    is_front = !is_front;
+    lv_image_set_src(main_img, is_front ? &AM62L_Front : &AM62L_Back);
+}
+
 /* -------------------------------------------------------------------------- */
 /* UI Setup                                                                   */
 /* -------------------------------------------------------------------------- */
@@ -153,6 +233,24 @@ void ui_create_image_viewer(lv_indev_t * indev)
     /* 4. Flags and Events */
     lv_obj_add_flag(img, LV_OBJ_FLAG_CLICKABLE);
     lv_obj_add_event_cb(img, img_event_cb, LV_EVENT_ALL, NULL);
+
+    /* 5. Create Flip Button */
+    lv_obj_t * flip_btn = lv_image_create(scr);
+    lv_image_set_src(flip_btn, &flip_icon);
+    lv_obj_align(flip_btn, LV_ALIGN_BOTTOM_RIGHT, -20, -20);
+    lv_obj_add_flag(flip_btn, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_event_cb(flip_btn, flip_btn_event_cb, LV_EVENT_CLICKED, img);
+
+    /* 6. Create FPS HUD */
+    fps_img_obj = lv_image_create(scr);
+    lv_image_set_src(fps_img_obj, &fps_img_dsc);
+    lv_image_set_pivot(fps_img_obj, 0, 0);
+    lv_image_set_scale(fps_img_obj, 512); // Scale 2x to make it legible
+    lv_obj_align(fps_img_obj, LV_ALIGN_TOP_LEFT, 10, 10);
+    update_fps_hud(0);
+
+    lv_display_add_event_cb(lv_display_get_default(), refr_event_cb, LV_EVENT_REFR_READY, NULL);
+    lv_timer_create(fps_timer_cb, 1000, NULL);
 }
 
 void force_screen_clear(void)

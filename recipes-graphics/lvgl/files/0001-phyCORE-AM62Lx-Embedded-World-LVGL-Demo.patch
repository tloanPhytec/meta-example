+/* -------------------------------------------------------------------------- */
+/* Helper: Clamp value between min and max                                    */
+/* -------------------------------------------------------------------------- */
+static int32_t clamp(int32_t val, int32_t min, int32_t max)
+{
+    if(val < min) return min;
+    if(val > max) return max;
+    return val;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Event Handler: Panning with Boundaries                                     */
+/* -------------------------------------------------------------------------- */
+static void img_event_cb(lv_event_t * e)
+{
+    lv_obj_t * img = lv_event_get_target(e);
+    lv_event_code_t code = lv_event_get_code(e);
+    lv_indev_t * indev = lv_indev_active();
+
+    if(code == LV_EVENT_PRESSING) {
+        lv_point_t vect;
+        if(indev) {
+            lv_indev_get_vect(indev, &vect);
+
+            /* Only process if there is movement */
+            if(vect.x != 0 || vect.y != 0) {
+
+                /* 1. Calculate the Potential New Position */
+                int32_t proposed_x = lv_obj_get_x(img) + vect.x;
+                int32_t proposed_y = lv_obj_get_y(img) + vect.y;
+
+                /* 2. Get Dimensions */
+                int32_t scr_w = lv_obj_get_width(lv_screen_active());
+                int32_t scr_h = lv_obj_get_height(lv_screen_active());
+                int32_t img_w = lv_obj_get_width(img);
+                int32_t img_h = lv_obj_get_height(img);
+
+                /* 3. Calculate X Boundaries */
+                int32_t min_x, max_x;
+                if(img_w > scr_w) {
+                    /* Image is wider than screen: Allow panning but no gaps */
+                    min_x = scr_w - img_w; /* Right edge of image hits right edge of screen */
+                    max_x = 0;             /* Left edge of image hits left edge of screen */
+                } else {
+                    /* Image is narrower than screen: Keep inside screen */
+                    min_x = 0;
+                    max_x = scr_w - img_w;
+                }
+
+                /* 4. Calculate Y Boundaries */
+                int32_t min_y, max_y;
+                if(img_h > scr_h) {
+                    min_y = scr_h - img_h;
+                    max_y = 0;
+                } else {
+                    min_y = 0;
+                    max_y = scr_h - img_h;
+                }
+
+                /* 5. Clamp and Apply */
+                int32_t final_x = clamp(proposed_x, min_x, max_x);
+                int32_t final_y = clamp(proposed_y, min_y, max_y);
+
+                lv_obj_set_pos(img, final_x, final_y);
+            }
+        }
+    }
+}
+
+/* -------------------------------------------------------------------------- */
+/* UI Setup                                                                   */
+/* -------------------------------------------------------------------------- */
+void ui_create_image_viewer(lv_indev_t * indev)
+{
+    lv_obj_t * scr = lv_screen_active();
+    lv_obj_set_style_bg_color(scr, lv_color_white(), 0);
+
+    /* 1. Create Image */
+    lv_obj_t * img = lv_image_create(scr);
+    lv_image_set_src(img, IMG_PATH);
+
+    /* 2. FORCE initial size calculation */
+    /* LVGL needs to read the file header to know how big the image is */
+    lv_obj_update_layout(img);
+
+    /* 3. Manually Center (One-time calculation) */
+    /* We use LV_ALIGN_TOP_LEFT (Default) so X,Y are absolute coordinates */
+    int32_t scr_w = lv_obj_get_width(scr);
+    int32_t scr_h = lv_obj_get_height(scr);
+    int32_t img_w = lv_obj_get_width(img);
+    int32_t img_h = lv_obj_get_height(img);
+
+    /* Set X/Y to the middle */
+    lv_obj_set_pos(img, (scr_w - img_w) / 2, (scr_h - img_h) / 2);
+
+    /* 4. Flags and Events */
+    lv_obj_add_flag(img, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_event_cb(img, img_event_cb, LV_EVENT_ALL, NULL);
+}
+
+void force_screen_clear(void)
+{
+    /* 1. Create a massive object that covers the whole screen */
+    lv_obj_t * wiper = lv_obj_create(lv_layer_sys()); // Use sys layer to be on top of everything
+    lv_obj_set_size(wiper, 1280, 800);
+    lv_obj_set_pos(wiper, 0, 0);
+
+    /* 2. Make it solid white (or black, if you prefer) */
+    lv_obj_set_style_bg_color(wiper, lv_color_white(), 0);
+    lv_obj_set_style_bg_opa(wiper, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(wiper, 0, 0);
+    lv_obj_set_style_radius(wiper, 0, 0);
+
+    /* 3. Force LVGL to render this immediately to the hardware */
+    lv_refr_now(lv_display_get_default());
+
+    /* 4. Delete the wiper. The screen is now "clean" white. */
+    lv_obj_delete(wiper);
+}

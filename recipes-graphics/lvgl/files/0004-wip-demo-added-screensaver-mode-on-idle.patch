 }
 
@@ -204,6 +208,53 @@ static void flip_btn_event_cb(lv_event_t * e)
     lv_image_set_src(main_img, is_front ? &AM62L_Front : &AM62L_Back);
 }
 
+/* -------------------------------------------------------------------------- */
+/* Screensaver Logic                                                          */
+/* -------------------------------------------------------------------------- */
+static void screensaver_timer_cb(lv_timer_t * t)
+{
+    uint32_t current_time = lv_tick_get();
+    if((current_time - last_activity_time) > 10000) {
+	lv_obj_t * img = lv_timer_get_user_data(t);
+        static int32_t vel_x = 3;
+        static int32_t vel_y = 3;
+
+        int32_t x = lv_obj_get_x(img);
+        int32_t y = lv_obj_get_y(img);
+
+        x += vel_x;
+        y += vel_y;
+
+        int32_t scr_w = lv_obj_get_width(lv_screen_active());
+        int32_t scr_h = lv_obj_get_height(lv_screen_active());
+        int32_t img_w = lv_obj_get_width(img);
+        int32_t img_h = lv_obj_get_height(img);
+
+        int32_t scale = lv_image_get_scale(img);
+        int32_t scaled_w = (img_w * scale) / 256;
+        int32_t scaled_h = (img_h * scale) / 256;
+
+        int32_t offset_x = (scaled_w - img_w) / 2;
+        int32_t offset_y = (scaled_h - img_h) / 2;
+
+        int32_t min_x = offset_x;
+        int32_t max_x = scr_w - scaled_w + offset_x;
+        if(scaled_w > scr_w) { min_x = scr_w - scaled_w + offset_x; max_x = offset_x; }
+
+        int32_t min_y = offset_y;
+        int32_t max_y = scr_h - scaled_h + offset_y;
+        if(scaled_h > scr_h) { min_y = scr_h - scaled_h + offset_y; max_y = offset_y; }
+
+        if(x <= min_x) { x = min_x; vel_x = -vel_x; }
+        else if(x >= max_x) { x = max_x; vel_x = -vel_x; }
+
+        if(y <= min_y) { y = min_y; vel_y = -vel_y; }
+        else if(y >= max_y) { y = max_y; vel_y = -vel_y; }
+
+        lv_obj_set_pos(img, x, y);
+    }
+}
+
 /* -------------------------------------------------------------------------- */
 /* UI Setup                                                                   */
 /* -------------------------------------------------------------------------- */
@@ -251,6 +302,9 @@ void ui_create_image_viewer(lv_indev_t * indev)
 
     lv_display_add_event_cb(lv_display_get_default(), refr_event_cb, LV_EVENT_REFR_READY, NULL);
     lv_timer_create(fps_timer_cb, 1000, NULL);
+
+    /* 7. Create Screensaver Timer (~60 FPS) */
+    lv_timer_create(screensaver_timer_cb, 16, img);
 }
 
 void force_screen_clear(void)

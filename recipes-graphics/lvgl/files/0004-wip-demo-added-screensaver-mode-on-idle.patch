Subject: [PATCH 4/4] wip demo: added screensaver mode on idle

- also quited a warning about implicit type conversions
- also improved overall framerate to 60fps

Signed-off-by: tloan <tloan@phytec.com>
---
 main.c | 56 +++++++++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 55 insertions(+), 1 deletion(-)

diff --git a/main.c b/main.c
index e2854aa..391defd 100644
--- a/main.c
+++ b/main.c
@@ -12,6 +12,8 @@ LV_IMAGE_DECLARE(flip_icon);
 /* -------------------------------------------------------------------------- */
 /* FPS HUD Data & Logic                                                       */
 /* -------------------------------------------------------------------------- */
+static uint32_t last_activity_time = 0;
+
 const unsigned char font8x8[14][8] = {
     {0x3E,0x61,0x61,0x61,0x61,0x61,0x3E,0x00}, // 0
     {0x18,0x08,0x08,0x08,0x08,0x08,0x08,0x00}, // 1
@@ -55,7 +57,7 @@ static int get_font_idx(char c) {
 
 static void update_fps_hud(uint32_t fps) {
     char str[16];
-    snprintf(str, sizeof(str), "FPS %-3lu", fps);
+    snprintf(str, sizeof(str), "FPS %-3u", fps);
     uint32_t fg = 0xFF000000; /* Solid Black */
     uint32_t bg = 0x00000000; /* 100% Transparent */
 
@@ -108,6 +110,7 @@ static void img_event_cb(lv_event_t * e)
     lv_indev_t * indev = lv_indev_active();
 
     if(code == LV_EVENT_PRESSING) {

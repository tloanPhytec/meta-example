From d7fd8b715e4fc000522b51606c185e786d537daf Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Wed, 25 Feb 2026 18:49:18 +0000
Subject: [PATCH 2/2] wip am62l 2D demo: add two finger touch support

Signed-off-by: tloan <tloan@phytec.com>
---
 main.c | 83 ++++++++++++++++++++++++++++++++++++++++++++++------------
 1 file changed, 66 insertions(+), 17 deletions(-)

diff --git a/main.c b/main.c
index 0d3b110..e3572b3 100644
--- a/main.c
+++ b/main.c
@@ -6,6 +6,17 @@
 
 LV_IMAGE_DECLARE(AM62L_Front);
 LV_IMAGE_DECLARE(AM62L_Back);
+
+/* -------------------------------------------------------------------------- */
+/* Helper: Calculate dist between two touch points for pinch-zoom feature     */
+/* -------------------------------------------------------------------------- */
+static uint32_t get_dist(lv_point_t * p1, lv_point_t * p2)
+{
+    int32_t dx = p1->x - p2->x;
+    int32_t dy = p1->y - p2->y;
+    return (uint32_t)lv_sqrt32(dx * dx + dy * dy);
+}
+
 /* -------------------------------------------------------------------------- */
 /* Helper: Clamp value between min and max                                    */
 /* -------------------------------------------------------------------------- */
@@ -17,17 +28,48 @@ static int32_t clamp(int32_t val, int32_t min, int32_t max)
 }
 
 /* -------------------------------------------------------------------------- */
-/* Event Handler: Panning with Boundaries                                     */
+/* Touch Handler                                                              */
 /* -------------------------------------------------------------------------- */
 static void img_event_cb(lv_event_t * e)
 {
+    static uint32_t start_dist = 0;
+    static int32_t start_scale = 256;
+
     lv_obj_t * img = lv_event_get_target(e);
     lv_event_code_t code = lv_event_get_code(e);
     lv_indev_t * indev = lv_indev_active();
 
     if(code == LV_EVENT_PRESSING) {
-        lv_point_t vect;
-        if(indev) {
+        lv_indev_t * indev1 = NULL;
+        lv_indev_t * indev2 = NULL;
+        lv_indev_t * curr = lv_indev_get_next(NULL);
+
+        /* Scan ALL indevs; Wayland interleaves touch, pointer, and keyboard */
+        while(curr) {
+            if(lv_indev_get_state(curr) == LV_INDEV_STATE_PRESSED) {
+                if(!indev1) indev1 = curr;
+                else if(!indev2) indev2 = curr;
+            }
+            curr = lv_indev_get_next(curr);
+        }
+
+        if(indev1 && indev2) {
+            lv_point_t p1, p2;
+	    lv_indev_get_point(indev1, &p1);
+            lv_indev_get_point(indev2, &p2);
+            uint32_t cur_dist = get_dist(&p1, &p2);
+
+            if(start_dist == 0) {
+                start_dist = cur_dist;
+                start_scale = lv_image_get_scale(img);
+            } else if(start_dist > 10) {
+                int32_t new_scale = (cur_dist * start_scale) / start_dist;
+                lv_image_set_scale(img, clamp(new_scale, 128, 2048));
+            }
+        }
+        else if(indev) {
+            start_dist = 0; // Reset pinch if only one finger is down
+            lv_point_t vect;
             lv_indev_get_vect(indev, &vect);
 
             /* Only process if there is movement */
@@ -40,29 +82,34 @@ static void img_event_cb(lv_event_t * e)
                 /* 2. Get Dimensions */
                 int32_t scr_w = lv_obj_get_width(lv_screen_active());
                 int32_t scr_h = lv_obj_get_height(lv_screen_active());
-                int32_t img_w = lv_obj_get_width(img);
-                int32_t img_h = lv_obj_get_height(img);
+		int32_t img_w = lv_obj_get_width(img);  /* Original Width */
+                int32_t img_h = lv_obj_get_height(img); /* Original Height */
+		int32_t scale = lv_image_get_scale(img);
+                int32_t scaled_w = (img_w * scale) / 256;
+                int32_t scaled_h = (img_h * scale) / 256;
+
+                /* Offset for Center-Pivot Scaling */
+                int32_t offset_x = (scaled_w - img_w) / 2;
+                int32_t offset_y = (scaled_h - img_h) / 2;
 
                 /* 3. Calculate X Boundaries */
                 int32_t min_x, max_x;
-                if(img_w > scr_w) {
-                    /* Image is wider than screen: Allow panning but no gaps */
-                    min_x = scr_w - img_w; /* Right edge of image hits right edge of screen */
-                    max_x = 0;             /* Left edge of image hits left edge of screen */
+		if(scaled_w > scr_w) {
+                    min_x = scr_w - scaled_w + offset_x;
+                    max_x = offset_x;
                 } else {
-                    /* Image is narrower than screen: Keep inside screen */
-                    min_x = 0;
-                    max_x = scr_w - img_w;
+		    min_x = offset_x;
+                    max_x = scr_w - scaled_w + offset_x;
                 }
 
                 /* 4. Calculate Y Boundaries */
                 int32_t min_y, max_y;
-                if(img_h > scr_h) {
-                    min_y = scr_h - img_h;
-                    max_y = 0;
+		if(scaled_h > scr_h) {
+                    min_y = scr_h - scaled_h + offset_y;
+                    max_y = offset_y;
                 } else {
-                    min_y = 0;
-                    max_y = scr_h - img_h;
+		    min_y = offset_y;
+                    max_y = scr_h - scaled_h + offset_y;
                 }
 
                 /* 5. Clamp and Apply */
@@ -72,6 +119,8 @@ static void img_event_cb(lv_event_t * e)
                 lv_obj_set_pos(img, final_x, final_y);
             }
         }
+    } else if(code == LV_EVENT_RELEASED) {
+        start_dist = 0;
     }
 }
 
-- 

[Unit]
Description=Autostart Flutter demo
Wants=weston.service
After=weston.service systemd-user-sessions.service

[Service]
Type=simple
User=root
Restart=on-failure
RestartSec=1
Environment="XDG_RUNTIME_DIR=/run/user/1000 LD_LIBRARY_PATH=/usr/share/flutter/3.24.4/release/lib/"
ExecStart=/usr/bin/flutter-client --bundle=/usr/share/flutter/flutter-samples-material-3-demo/3.24.4/release/

[Install]
WantedBy=multi-user.target

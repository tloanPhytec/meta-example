From bf1ced17495d8ab430c72d73bd9f0fc9a9ea1de4 Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Thu, 4 Sep 2025 16:37:02 +0000
Subject: [PATCH] arch: arm64: dts: imx8mp-phyboard-pollux-custom.dtso example
 overlay

Signed-off-by: tloan <tloan@phytec.com>
---
 arch/arm64/boot/dts/freescale/Makefile        |  2 ++
 .../imx8mp-phyboard-pollux-custom.dtso        | 27 +++++++++++++++++++
 2 files changed, 29 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-custom.dtso

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 89183c1eb27c..fb84261f2fb0 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -138,6 +138,7 @@ imx8mp-phyboard-pollux-isp-csi1-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-ph
 imx8mp-phyboard-pollux-isp-csi2-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phyboard-pollux-isp-csi2.dtbo
 imx8mp-phyboard-pollux-peb-av-10-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phyboard-pollux-peb-av-10.dtbo
 imx8mp-phyboard-pollux-peb-wlbt-05-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phyboard-pollux-peb-wlbt-05.dtbo
+imx8mp-phyboard-pollux-custom-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phyboard-pollux-custom.dtbo
 imx8mp-phyboard-pollux-rdk-no-eth-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phycore-no-eth.dtbo
 imx8mp-phyboard-pollux-rdk-no-rtc-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phycore-no-rtc.dtbo
 imx8mp-phyboard-pollux-rdk-no-spiflash-dtbs += imx8mp-phyboard-pollux-rdk.dtb imx8mp-phycore-no-spiflash.dtbo
@@ -179,6 +180,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-isp-csi1.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-isp-csi2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-peb-av-10.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-peb-wlbt-05.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-custom.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-rdk-no-eth.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-rdk-no-rtc.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mp-phyboard-pollux-rdk-no-spiflash.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-custom.dtso b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-custom.dtso
new file mode 100644
index 000000000000..87baf7d1acdf
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-custom.dtso
@@ -0,0 +1,27 @@
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/imx8mp-clock.h>
+#include "imx8mp-pinfunc.h"
+
+&uart3 {
+	assigned-clocks = <&clk IMX8MP_CLK_UART3>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
+	dma-names = "";
+	dmas = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart3>;
+	uart-has-rtscts;
+	status = "okay";
+};
+	
+&iomuxc {
+	pinctrl_uart3: uart3grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_UART3_RXD__UART3_DCE_RX	0x140
+			MX8MP_IOMUXC_UART3_TXD__UART3_DCE_TX	0x140
+			MX8MP_IOMUXC_SD1_RESET_B__UART3_DCE_RTS	0x140
+			MX8MP_IOMUXC_SD1_STROBE__UART3_DCE_CTS	0x140
+		>;
+	};
+};
-- 
2.25.1


software =
{
    version = "1.0";

    hardware-compatibility = [ "1.0" ];

    scripts: (
        {
            filename = "update.sh";
            type = "shellscript";
        }
    );

    images: (
        {
            filename = "phytec-headless-image-phyboard-pollux-imx8mp-3.rootfs.ext4";
            device = "/dev/update_root";
            type = "raw";
        }
    );

    files: (
        {
            filename = "fitImage";
            device = "/dev/update_boot";
            filesystem = "vfat";
            path = "/fitImage";
        }
    );
};

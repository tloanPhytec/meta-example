From 97e4872fdeeed148d01387cacf9a0e76df0fa8da Mon Sep 17 00:00:00 2001
From: tloan <tloan@phytec.com>
Date: Mon, 14 Sep 2026 17:13:29 +0000
Subject: [PATCH 2/2] electra: add print of eMMC boot part used during boot

Signed-off-by: tloan <tloan@phytec.com>
---
 common/spl/spl_mmc.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/common/spl/spl_mmc.c b/common/spl/spl_mmc.c
index d06f9f0dee6..137b67ef8b5 100644
--- a/common/spl/spl_mmc.c
+++ b/common/spl/spl_mmc.c
@@ -369,6 +369,16 @@ int spl_mmc_load(struct spl_image_info *spl_image,
 		}
 	}
 
+#ifdef CONFIG_SPL_LIBCOMMON_SUPPORT
+	{
+		int hwpart = EXT_CSD_EXTRACT_BOOT_PART(mmc->part_config);
+		if (hwpart == 1)
+			printf(" -> Accessing eMMC boot0 partition\n");
+		else if (hwpart == 2)
+			printf(" -> Accessing eMMC boot1 partition\n");
+	}
+#endif
+
 	boot_mode = spl_mmc_boot_mode(mmc, bootdev->boot_device);
 	ret = -EINVAL;
 	switch (boot_mode) {
-- 
2.34.1

